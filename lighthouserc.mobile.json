{
  "ci": {
    "collect": {
      "url": ["http://localhost:3100/"],
      "numberOfRuns": 1,
      "settings": {
        "throttlingMethod": "devtools"
      }
    },
    "assert": {
      "assertions": {
        "largest-contentful-paint": ["warn", { "maxNumericValue": 2500 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci-mobile"
    }
  }
}
